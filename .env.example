# NordVPN credentials (use NordVPN service credentials, not your login)
# Find them at: https://my.nordaccount.com/dashboard/nordvpn/manual-configuration/
VPN_USER=your_nordvpn_service_username
VPN_PASSWORD=your_nordvpn_service_password
VPN_COUNTRY=United States

# File permission IDs (default: your current user)
PUID=501
PGID=20

# Media storage base path
MEDIA_PATH=/Users/raven/media
