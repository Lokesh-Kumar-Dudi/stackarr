# ProtonVPN WireGuard credentials (required)
# Get your key at: https://account.proton.me/u/0/vpn/WireGuard
VPN_WIREGUARD_KEY=your_protonvpn_wireguard_private_key
VPN_COUNTRY=United States

# File permission IDs (match the user running Docker)
# Linux: run `id -u` and `id -g`
# macOS: run `id -u` and `id -g` (common defaults are 501 and 20)
# Windows:
#   - Docker Desktop + WSL: run `id -u` and `id -g` inside your WSL distro
#   - Docker Desktop without WSL bind-mount issues: you can usually leave these defaults
PUID=501
PGID=20

# Media storage base path
# on macos/linux
MEDIA_PATH=/Users/raven/media

# on windows
# MEDIA_PATH=C:\Users\raven\media or Z:\media