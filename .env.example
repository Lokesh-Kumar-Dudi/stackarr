# Surfshark WireGuard credentials (required)
# Generate a key pair at: https://my.surfshark.com/vpn/manual-setup/main/wireguard
# Open the downloaded .conf file — copy PrivateKey and Address from it.
VPN_WIREGUARD_KEY=your_surfshark_wireguard_private_key
VPN_WIREGUARD_ADDRESSES=10.14.0.2/16

# File permission IDs (match the user running Docker)
# Linux: run `id -u` and `id -g`
# macOS: run `id -u` and `id -g` (common defaults are 501 and 20)
# Windows:
#   - Docker Desktop + WSL: run `id -u` and `id -g` inside your WSL distro
#   - Docker Desktop without WSL bind-mount issues: you can usually leave these defaults
PUID=501
PGID=20

# Media storage base path
# on macos/linux
MEDIA_PATH=/Users/raven/media

# on windows
# MEDIA_PATH=C:\Users\raven\media or Z:\media

# Speedtest Tracker
# Generate a key with: echo "base64:$(openssl rand -base64 32)"
SPEEDTEST_APP_KEY=base64:your_generated_key_here
SPEEDTEST_APP_URL=http://localhost:8081